{
  "$schema": "https://schema.railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "startCommand": "npx serve dist --listen $PORT --no-clipboard",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
